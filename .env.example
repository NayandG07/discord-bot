# ==========================================
# DEVGUILD ENVIRONMENT CONFIGURATION
# ==========================================

# Application Environment
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
APP_NAME=DevGuild
COMBINED_MODE=true # Set to true to run API + Discord Bot + BullMQ Workers in a single process (ideal for Render/Koyeb free tier)

# Database (PostgreSQL 15/16 - Local or Supabase)
# For Supabase: DATABASE_URL should be the Transaction Pooler (port 6543)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
# For Supabase: DIRECT_URL is the direct connection (port 5432) for running Prisma migrations
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Local Docker Fallbacks
POSTGRES_USER=devguild_user
POSTGRES_PASSWORD=devguild_secure_pass_2026
POSTGRES_DB=devguild_db
POSTGRES_PORT=5432

# Redis Cache & BullMQ (Local Docker, Redis Cloud, or Aiven)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass_2026
REDIS_DB=0
REDIS_PREFIX=devguild:
REDIS_TLS=false # Set to true if connecting to cloud Redis with TLS/rediss://

# Discord Bot Credentials
DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_PUBLIC_KEY=your_discord_public_key_here
DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/auth/discord/callback

# Security & JWT Secrets
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=900s
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# LeetCode Scraper Settings
LEETCODE_GRAPHQL_ENDPOINT=https://leetcode.com/graphql
LEETCODE_POLL_INTERVAL_MINUTES=15
LEETCODE_REQUEST_RATE_LIMIT=10

# Media & Storage (Optional AWS S3 for Canvas cards)
AWS_REGION=us-east-1
AWS_S3_BUCKET=devguild-cdn
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CDN_BASE_URL=https://devguild.io/cdn
